# Server
PORT=8000
HOST=0.0.0.0

# Database
DATABASE_URL=postgres://user:password@host:5432/sportz
DATABASE_URL_UNPOOLED=postgres://user:password@host:5432/sportz

# Arcjet
ARCJET_KEY=
ARCJET_ENV=development
ARCJET_MODE=DRY_RUN

# SportScore integration
# Polling is enabled by default; set to false to disable background sync.
SPORTSCORE_POLL_ENABLED=true
SPORTSCORE_BASE_URL=https://sportscore.com
SPORTSCORE_API_KEY=
SPORTSCORE_SRC=sportz-dashboard

# Comma-separated <sport>:<competition-slug> entries.
# Leave empty to discover all football and cricket fixtures globally.
SPORTSCORE_COMPETITIONS=

# Linked-only sync by default. Set to true to import nearby fixtures that
# are not yet linked to an internal match. Recently finished matches inside
# the window are also imported so their incidents can become commentary.
SPORTSCORE_AUTO_IMPORT=true
SPORTSCORE_AUTO_IMPORT_WINDOW_HOURS=6

# Store generated football substitution commentary (goals and cards are
# always ingested when detail data is polled).
SPORTSCORE_INGEST_SUBSTITUTIONS=true

# Cricket has no live detail feed, so only fixture-level scores/status sync.
SPORTSCORE_CRICKET_ENABLED=true

# Poll cadence and request budget.
SPORTSCORE_POLL_INTERVAL_MS=180000
SPORTSCORE_DETAIL_POLL_INTERVAL_MS=300000
SPORTSCORE_REQUEST_TIMEOUT_MS=10000
SPORTSCORE_MAX_REQUESTS_PER_DAY=15000
SPORTSCORE_RECONCILE_LIMIT=25

SPORTSCORE_USER_AGENT=sportz-dashboard/1.0 (+https://sportscore.com/developers/)
